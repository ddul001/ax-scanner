     "outputModes": [
      "application/vnd.autoagent.inventory-facets-response+json"
     ]
    },
    {
     "id": "inventory.search",
     "name": "Inventory Search",
     "description": "Find vehicles using advertised constraints, source-backed equipment, rooftop radius and complete cursor pagination. Return applied filters, freshness and authoritative prices.",
     "tags": [
      "inventory",
      "vehicles",
      "search",
      "cars",
      "motorcycles",
      "powersports",
      "automotive"
     ],
     "inputModes": [
      "application/vnd.autoagent.inventory-search-request+json"
     ],
     "outputModes": [
      "application/vnd.autoagent.inventory-search-response+json"
     ]
    },
    {
     "id": "inventory.vehicle",
     "name": "Vehicle Detail",
     "description": "Read one listing by VIN, stock or vehicle ID, including current status, equipment evidence, pricing and relevant specifications.",
     "tags": [
      "inventory",
      "vehicle",
      "vin",
      "stock",
      "detail",
      "automotive",
      "motorcycles",
      "powersports"
     ],
     "inputModes": [
      "application/vnd.autoagent.vehicle-detail-request+json"
     ],
     "outputModes": [
      "application/vnd.autoagent.vehicle-detail-response+json"
     ]
    },
    {
     "id": "lead.submit",
     "name": "Submit Lead",
     "description": "Submit one explicitly consented inquiry with optional vehicle, trade-in and appointment details. Require an idempotency key; duplicate suppression lasts at least 24 hours. Reconcile uncertain outcomes before retrying after that window. Report lead and booking outcomes separately.",
     "tags": [
      "lead",
      "contact",
      "consent",
      "sales",
      "appointment",
      "automotive",
      "motorcycles",
      "powersports"
     ],
